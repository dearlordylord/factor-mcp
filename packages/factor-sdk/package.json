{
  "name": "@firfi/factor-sdk",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "description": "Typed local SDK for Factor Meals Canada account, recipes, history, and weekly selections",
  "license": "MIT",
  "author": "firfi",
  "engines": {
    "node": "^22.22.2 || ^24.15.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dearlordylord/factor-mcp.git",
    "directory": "packages/factor-sdk"
  },
  "homepage": "https://github.com/dearlordylord/factor-mcp#readme",
  "bugs": {
    "url": "https://github.com/dearlordylord/factor-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "LICENSE"
  ]
